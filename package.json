{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js figma-plugin-build figma-plugin/ui.html figma-plugin/code.js",
    "lint": "tsc --noEmit",
    "build:plugin:ui": "vite build --config vite.config.plugin.ts && cp figma-plugin-build/index.html figma-plugin/ui.html",
    "build:plugin:code": "tsc figma-plugin/src/code.ts --outDir figma-plugin --target ES2017 --module commonjs --types @figma/plugin-typings --strict --esModuleInterop --skipLibCheck",
    "build:plugin": "npm run build:plugin:ui && npm run build:plugin:code && rm -rf figma-plugin-build"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.127.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
